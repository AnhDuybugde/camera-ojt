# Environments and secrets
**/.venv/
**/.env
!**/.env.example

# Python and test caches
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/

# Runtime data and models
backend/output/*
backend/logs/*
backend/models/*
backend/data/images/*
backend/data/faces/*
frontend/data/*
frontend/logs/*
frontend/static/zone_samples/*
*.pt
*.onnx
*.engine

# Frontend/build output
backend/dashboard/node_modules/
backend/dashboard/dist/
frontend/.streamlit/secrets.toml

# Integrated launcher state
.runtime/
logs/

# Preserve empty folders when present
!backend/output/.gitkeep
!backend/models/.gitkeep
!backend/data/images/.gitkeep
!frontend/static/zone_samples/.gitkeep
