# Copy sang .env va dien thong tin that (file .env khong commit).
#   cp .env.example .env   (Linux)  |  Copy-Item .env.example .env   (Windows)

# Production defaults to monitor-only biometric mode until an audited liveness
# provider is integrated and the operator explicitly enables automatic writes.
APP_ENV=development
ATTENDANCE_AUTOMATION_ENABLED=false
# BIOMETRIC_LIVENESS_PROVIDER=your_audited_provider

# --- Camera IMOU: RTSP mic + hinh (bat buoc cho ban camera) ---
IMOU_IP=192.168.100.77
IMOU_USER=admin
IMOU_PASSWORD=changeme

# --- Loa camera: backend mac dinh la imou_p2p (P2P VisualTalk) ---
# IMOU_DEVICE_ID = serial camera. IMOU_CAMERA_PASSWORD = device password /
# safety code in tren tem camera (fallback: IMOU_PASSWORD, IMOU_DEVICE_CODE).
IMOU_DEVICE_ID=your_camera_serial_number
IMOU_CAMERA_PASSWORD=your_camera_safety_code
# Device code / safety code cu (van dung lam fallback cho P2P).
IMOU_DEVICE_CODE=your_camera_device_code
# Kenh loa VisualTalk nam trong config/default.yaml
# (voice.p2p_channel / voice.p2p_channel_b), khong can .env.

# --- Bé Xinh voice chat (Gemini, mic + loa camera) ---
GEMINI_API_KEY=your_gemini_api_key
# Stable model requested for low-latency Vietnamese Q&A.
GEMINI_MODEL=gemini-3.5-flash

# --- Supabase (tuy chon; lay tu Dashboard > Project Settings > API) ---
# - Pipeline (service_key, BYPASS RLS, chi de tren may chay camera):
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...
# - Dashboard web (anon key, bi RLS gioi han quyen):
SUPABASE_ANON_KEY=eyJ...anon...
# Bat dong bo Supabase trong config/default.yaml: store.supabase_enabled: true
# Chuoi Postgres truc tiep (tuy chon, hien chua dung trong code).
# CONNECT_STRING=postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres

# --- Legacy imou_web (WebSDK AudioTalk, chi dung khi voice.backend=imou_web) ---
# IMOU_APP_ID=your_open_platform_app_id
# IMOU_APP_SECRET=your_open_platform_app_secret
# IMOU_CHANNEL_ID=0
# IMOU_DATA_CENTER=sg
# Thu muc SDK da giai nen, chua imou-player.js va WasmLib/. De ngoai Git.
# IMOU_WEBSDK_DIR=C:\path\to\imou-player
# Tuy chon; bo trong de tu tim Edge/Chrome.
# IMOU_BROWSER_EXECUTABLE=

# --- Bé Xinh companion (audio của branch Ngoc) ---
# Bridge đọc người đã nhận diện từ backend, không mở camera/model lần hai.
TRACKING_STATUS_URL=http://127.0.0.1:8765/status.json
IMOU_TALK_PORT=8086
IMOU_TALK_HELPER=C:\path\to\frigate_imou_talk_exec.py
CAMERA_TTS_VOICE=hamy
CAMERA_TTS_GAIN=1.0
CAMERA_TTS_COOLDOWN_SECONDS=30
# Live occupancy excludes identities not observed within this TTL while keeping
# count_logical available for audit/reconciliation.
OCCUPANCY_STALE_SECONDS=15
# Production nên prewarm cache trước và giữ false để không tranh GPU với model.
HAMY_RUNTIME_SYNTHESIS=false
HAMY_AUDIO_CACHE_DIR=output/hamy_audio_cache
HAMY_REENTRY_SECONDS=45
HAMY_ARRIVAL_DELAY_SECONDS=5
HAMY_ARRIVAL_GROUP_WINDOW_SECONDS=0.25
HAMY_ARRIVAL_BURST_SECONDS=12
HAMY_GLOBAL_EVENT_GAP_SECONDS=7
HAMY_WAVE_GLOBAL_GAP_SECONDS=15
HAMY_APPROACH_COOLDOWN_SECONDS=180
HAMY_STAND_COOLDOWN_SECONDS=180
# 5-finger/open-palm greeting. The model process emits compact events to the
# Bé Xinh bridge; it does not open either RTSP stream a second time.
HAMY_GESTURE_ENABLED=true
HAMY_GESTURE_INTERVAL_SECONDS=0.10
HAMY_GESTURE_MAX_CANDIDATES=4
HAMY_GESTURE_COOLDOWN_SECONDS=20
HAMY_GESTURE_CONFIRM_HITS=2
HAMY_GESTURE_RELEASE_SECONDS=1.0
HAMY_GESTURE_MIN_CONFIDENCE=0.70
HAMY_GESTURE_MAX_HAND_CENTER_Y=0.68
HAMY_GESTURE_MIN_PALM_WIDTH_RATIO=0.20
# Monocular proximity calibration. Measure the person's bbox-height ratio at
# exactly 1 m, then update HAMY_DISTANCE_REFERENCE_HEIGHT_RATIO. The default
# 0.45 makes a near-full-height box (~0.90) correspond to roughly 0.50 m.
HAMY_GREET_ONLY_WHEN_NEAR=true
HAMY_DISTANCE_REFERENCE_METERS=1.0
HAMY_DISTANCE_REFERENCE_HEIGHT_RATIO=0.45
HAMY_GREETING_DISTANCE_METERS=0.50
HAMY_DISTANCE_RELEASE_METERS=0.70
HAMY_NEAR_CONFIRM_SECONDS=0.25
# Friendly check-in after 20 minutes of stationary work without a high-five;
# at most once every 30 minutes per person/group.
HAMY_BANTER_AFTER_SECONDS=1200
HAMY_BANTER_REPEAT_SECONDS=1800
HAMY_WATER_AFTER_SECONDS=2700
HAMY_WATER_REPEAT_SECONDS=3600
HAMY_REST_AFTER_SECONDS=5400
HAMY_REST_REPEAT_SECONDS=5400

# --- Bé Xinh semantic Audio Zone Event Engine ---
# Detection publishes top-level "audio_events": [] in /status.json. Presence
# greetings remain compatible until that field appears; an empty list still
# means Zone Mode is active and "thấy mặt" alone must stay silent.
HAMY_ZONE_EVENTS_ENABLED=true
# Chỉ bật khi cần debug polygon trên luồng camera quan sát.
HAMY_ZONE_OVERLAY_ENABLED=false
HAMY_AUTO_ARRIVAL_FROM_PRESENCE=true
HAMY_EVENT_GLOBAL_GAP_SECONDS=3
HAMY_EVENT_PERSON_GAP_SECONDS=8
HAMY_EVENT_MAX_AGE_SECONDS=20
HAMY_EVENT_FUTURE_TOLERANCE_SECONDS=10
HAMY_EVENT_DEDUPE_TTL_SECONDS=3600
HAMY_EVENT_DEDUPE_MAX_ENTRIES=4096
HAMY_GROUP_DOOR_ARRIVALS=true
HAMY_WAVE_COOLDOWN_SECONDS=10
HAMY_DOOR_ENTER_COOLDOWN_SECONDS=300
HAMY_DOOR_EXIT_COOLDOWN_SECONDS=300
HAMY_BE_XINH_COOLDOWN_SECONDS=600
HAMY_BE_XINH_MIN_DWELL_SECONDS=0.8
HAMY_WATER_ZONE_COOLDOWN_SECONDS=3600
HAMY_WATER_ZONE_MIN_DWELL_SECONDS=1.5
HAMY_RESTROOM_COOLDOWN_SECONDS=1800
HAMY_RESTROOM_MIN_DWELL_SECONDS=1.0

# --- Production network boundary ---
# Camera/status/control services should bind 127.0.0.1 and be exposed only
# through an authenticated reverse proxy/VPN. Set exact dashboard origins:
CAMERA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501
# Emergency/development escape hatches. Leave unset in production.
# CAMERA_ALLOW_REMOTE_STREAM=1
# CAMERA_ALLOW_REMOTE_CONTROL=1
