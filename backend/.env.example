# Copy sang .env va dien thong tin that (file .env khong commit).
#   cp .env.example .env   (Linux)  |  Copy-Item .env.example .env   (Windows)

# --- Camera IMOU: RTSP mic + hinh (bat buoc cho ban camera) ---
IMOU_IP=192.168.100.77
IMOU_USER=admin
IMOU_PASSWORD=changeme

# --- Loa camera: backend mac dinh la imou_p2p (P2P VisualTalk) ---
# IMOU_DEVICE_ID = serial camera. IMOU_CAMERA_PASSWORD = device password /
# safety code in tren tem camera (fallback: IMOU_PASSWORD, IMOU_DEVICE_CODE).
IMOU_DEVICE_ID=your_camera_serial_number
IMOU_CAMERA_PASSWORD=your_camera_safety_code
# Device code / safety code cu (van dung lam fallback cho P2P).
IMOU_DEVICE_CODE=your_camera_device_code
# Kenh loa VisualTalk nam trong config/default.yaml
# (voice.p2p_channel / voice.p2p_channel_b), khong can .env.

# --- Tro ly voice Ha Linh (Gemini, bat buoc neu chay --halinh) ---
GEMINI_API_KEY=your_gemini_api_key
# Ten model Gemini (tuy chon, mac dinh gemini-3.6-flash).
# GEMINI_MODEL=gemini-3.6-flash

# --- Supabase (tuy chon; lay tu Dashboard > Project Settings > API) ---
# - Pipeline (service_key, BYPASS RLS, chi de tren may chay camera):
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...
# - Dashboard web (anon key, bi RLS gioi han quyen):
SUPABASE_ANON_KEY=eyJ...anon...
# Bat dong bo Supabase trong config/default.yaml: store.supabase_enabled: true
# Chuoi Postgres truc tiep (tuy chon, hien chua dung trong code).
# CONNECT_STRING=postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres

# --- Legacy imou_web (WebSDK AudioTalk, chi dung khi voice.backend=imou_web) ---
# IMOU_APP_ID=your_open_platform_app_id
# IMOU_APP_SECRET=your_open_platform_app_secret
# IMOU_CHANNEL_ID=0
# IMOU_DATA_CENTER=sg
# Thu muc SDK da giai nen, chua imou-player.js va WasmLib/. De ngoai Git.
# IMOU_WEBSDK_DIR=C:\path\to\imou-player
# Tuy chon; bo trong de tu tim Edge/Chrome.
# IMOU_BROWSER_EXECUTABLE=

# --- Bé Xinh companion (audio của branch Ngoc) ---
# Bridge đọc người đã nhận diện từ backend, không mở camera/model lần hai.
TRACKING_STATUS_URL=http://127.0.0.1:8765/status.json
IMOU_TALK_PORT=8086
IMOU_TALK_HELPER=C:\path\to\frigate_imou_talk_exec.py
CAMERA_TTS_VOICE=hamy
CAMERA_TTS_GAIN=1.0
CAMERA_TTS_COOLDOWN_SECONDS=30
# Production nên prewarm cache trước và giữ false để không tranh GPU với model.
HAMY_RUNTIME_SYNTHESIS=false
HAMY_AUDIO_CACHE_DIR=output/hamy_audio_cache
HAMY_REENTRY_SECONDS=45
HAMY_ARRIVAL_GROUP_WINDOW_SECONDS=0.25
HAMY_ARRIVAL_BURST_SECONDS=12
HAMY_GLOBAL_EVENT_GAP_SECONDS=7
HAMY_APPROACH_COOLDOWN_SECONDS=180
HAMY_STAND_COOLDOWN_SECONDS=180
HAMY_WATER_AFTER_SECONDS=2700
HAMY_WATER_REPEAT_SECONDS=3600
HAMY_REST_AFTER_SECONDS=5400
HAMY_REST_REPEAT_SECONDS=5400
