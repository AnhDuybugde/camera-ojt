# Camera services stay local; expose only through a reverse proxy/VPN.
CAMERA_CORS_ORIGINS=https://camera.example.internal
# Escape hatches below should normally remain unset in production.
# CAMERA_ALLOW_REMOTE_STREAM=1
# CAMERA_ALLOW_REMOTE_CONTROL=1

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Keep false during shadow/pilot. Enable only after liveness + HR sign-off.
ATTENDANCE_AUTOMATION_ENABLED=false
ATTENDANCE_ENTRY_CHANNEL=B
BIOMETRIC_LIVENESS_PROVIDER=
BIOMETRIC_LIVENESS_URL=http://127.0.0.1:8890/verify
BIOMETRIC_LIVENESS_TOKEN=
BIOMETRIC_LIVENESS_THRESHOLD=0.80
BIOMETRIC_LIVENESS_TIMEOUT_SECONDS=1.5

BE_XINH_VOICE_ENABLED=false
BE_XINH_REALTIME_MODE=live
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
BE_XINH_CONVERSATION_IDLE_SECONDS=45
