# Set this only after verifying migration. PostgreSQL is the production source
# of truth; blank means the existing SQLite databases remain active.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_mind_attendance
# DATABASE_URL=sqlite:///data/database.db

# Camera: integer webcam index or an RTSP URL.
# Use CAMERA_SOURCE for one webcam/RTSP stream, or CAMERA_CONFIG_FILE to import
# USERNAME/RAW_PASSWORD/IP/PORT and both Imou channels from an existing Python file.
CAMERA_SOURCE=0
CAMERA_CONFIG_FILE=
# Leave blank to use the first attendance camera; use 0 for the laptop webcam.
REGISTRATION_CAMERA_SOURCE=0
CAMERA_RECONNECT_DELAY=3
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
RTSP_TRANSPORT=tcp

FACE_THRESHOLD=0.50
FACE_DETECTION_THRESHOLD=0.45
LIVE_MIN_FACE_SIZE=24
LIVE_BLUR_THRESHOLD=3
FACE_REQUIRE_PERSON_BOX=false
FACE_USE_MAIN_STREAM=true
FACE_TRACK_DISTANCE=220
FACE_CONFIRM_VOTES=2
FACE_CONFIRM_RATIO=0.60
FACE_VOTE_WINDOW_SECONDS=12
FACE_IDENTITY_TTL_SECONDS=15
PROCESS_EVERY_N_FRAMES=3
RECOGNITION_INTERVAL=0.65
DETECTION_SIZE=640
MIN_FACE_SIZE=80
BLUR_THRESHOLD=12
REGISTRATION_SAMPLES=12
REGISTRATION_INTERVAL=0.35
ENABLE_LIVENESS=false

ATTENDANCE_COOLDOWN=60
CHECKOUT_MIN_MINUTES=240
WORK_START_TIME=09:00
MORNING_END_TIME=12:00
AFTERNOON_START_TIME=14:00
WORK_END_TIME=17:30
LATE_THRESHOLD=09:15
# Morning ON shifts without a check-in become ABSENT at this time.
ABSENT_AFTER=09:30
# Applies to explicit temporary check-out events, excluding the lunch break.
PRESENCE_TIMEOUT_MINUTES=30

GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=
GOOGLE_WORKSHEET=Attendance
LOG_LEVEL=INFO

# Spatial analytics (stored separately in data/spatial_analytics.db)
SPATIAL_ANALYSIS_INTERVAL=0.8
SPATIAL_SAMPLE_INTERVAL=5
SPATIAL_IDENTITY_INTERVAL=3
SPATIAL_TRACK_DISTANCE=140
SPATIAL_TRACK_MAX_MISSED=5

# Lightweight rule-based activity estimation (independent from attendance).
ACTIVITY_ENABLED=true
POSE_MODEL=yolo11n-pose.pt
ACTIVITY_PROCESS_EVERY_N_FRAMES=3
ACTIVITY_POSE_IMAGE_SIZE=416
ACTIVITY_POSE_CONFIDENCE=0.35
ACTIVITY_WINDOW_SECONDS=5
ACTIVITY_CONFIRM_RATIO=0.70
ACTIVITY_SLEEP_MIN_SECONDS=25
ACTIVITY_DRINK_MIN_SECONDS=1.5
ACTIVITY_WALKING_MIN_SECONDS=1.2
ACTIVITY_STANDING_MIN_SECONDS=1.5
ACTIVITY_DESK_MIN_SECONDS=2
ACTIVITY_AWAY_MIN_SECONDS=2
ACTIVITY_MOVEMENT_THRESHOLD=0.035
ACTIVITY_IDENTITY_TTL_SECONDS=15
ACTIVITY_TRACK_DISTANCE=140
ACTIVITY_TRACK_MAX_MISSED=8
ACTIVITY_DESK_ZONE_IDS=workspace,desk,desk_zone_1
# Normalized camera polygons. Calibrate these for the actual camera view.
# SPATIAL_ZONES_JSON=[{"id":"entrance","label":"Lối vào","points":[[0,0],[0.3,0],[0.3,1],[0,1]]},{"id":"workspace","label":"Khu làm việc","points":[[0.3,0],[1,0],[1,1],[0.3,1]]}]
# development | production. Production requires strong bootstrap credentials.
APP_ENV=development
ADMIN_BOOTSTRAP_PASSWORD=
EMPLOYEE_BOOTSTRAP_PASSWORD=
SESSION_IDLE_TIMEOUT_MINUTES=30
